{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "lifts-web",
  // Set this to today's date
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_console_module"],
  "dev": {
    "port": 3000,
    "ip": "0.0.0.0",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "LIFTS_DB",
      "database_name": "lifts-db",
      "database_id": "2f70c6df-2f4a-4b8b-880e-cd92245a2b73",
      "migrations_dir": "./drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RIDE_INFO_STREAM",
        "class_name": "RideInfoStream",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RideInfoStream"],
    },
  ],
  "triggers": {
    "crons": ["15 * * * *"],
  },
  "vars": {
    "ENV": "production",
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "LIFTS_DB",
        "database_name": "lifts-preview-db",
        "database_id": "7c946999-66c3-484b-b00b-081bd9d7ff20",
        "migrations_dir": "./drizzle",
      },
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "RIDE_INFO_STREAM",
          "class_name": "RideInfoStream",
        },
      ],
    },
    "vars": {
      "ENV": "preview",
    },
  },
}
